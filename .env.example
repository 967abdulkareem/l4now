# Only needed if upgrading to automated WhatsApp Business Cloud API sending.
# Get this from Meta for Developers. NEVER commit the real value — set it as
# a GitHub Actions / hosting-platform secret instead.
WHATSAPP_CLOUD_API_TOKEN=

# Optional. Set to /<repo-name> when deploying to a GitHub Pages project site.
# Leave empty for a custom domain, the repo root, or local development.
NEXT_PUBLIC_BASE_PATH=
